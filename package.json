{
  "name": "dsh-dfy-mirror",
  "version": "2.4.2",
  "description": "dfy蓝色大肥鱼手机镜像：给 DSH 加手机投屏，scrcpy 原生窗口当画面，DSH 浮窗 / 桌面控制窗 / 设置页三个入口，一个进程一个状态机。",
  "type": "module",
  "license": "MIT",
  "author": "xiaozqi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaozqi/dsh-dfy-mirror.git"
  },
  "homepage": "https://github.com/xiaozqi/dsh-dfy-mirror#readme",
  "bugs": {
    "url": "https://github.com/xiaozqi/dsh-dfy-mirror/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "android",
    "scrcpy",
    "mirror"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "tools",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LESSONS.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ],
      "immediately": true
    }
  }
}
