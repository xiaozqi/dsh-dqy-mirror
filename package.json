{
  "name": "dsh-dqy-mirror",
  "version": "4.7.1",
  "description": "Android screen mirroring for DeepSeek Harness: one scrcpy window, one state machine, one capsule in the DSH header. Windows only.",
  "type": "module",
  "license": "MIT",
  "author": "xiaozqi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaozqi/dsh-dqy-mirror.git"
  },
  "homepage": "https://github.com/xiaozqi/dsh-dqy-mirror#readme",
  "bugs": {
    "url": "https://github.com/xiaozqi/dsh-dqy-mirror/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "android",
    "scrcpy",
    "mirror",
    "adb",
    "screen-mirroring"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "install-to-dsh.cmd",
    "install-to-dsh.ps1",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LESSONS.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/panel.js && node --check lib/session.js && node --check lib/unlock.js && node --check lib/config.js && node --check lib/args.js && node --check lib/exec.js",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
